# API de pey — https://docs.pey.mx
PEY_API_KEY=
PEY_BASE_URL=https://api.pey.mx

# Secreto de firma del webhook (se muestra al crear el webhook en el portal de pey, sección Desarrollador)
PEY_WEBHOOK_SECRET=

# URL pública de tu app (para mostrar la URL del webhook en pantalla). Ej. tu túnel de ngrok/cloudflared.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: cuenta registrada en pey (bankAccountId, ULID) donde SEDECO recibiría la devolución del Impulso.
# Si está vacío, la devolución a SEDECO se marca como simulada.
SEDECO_BANK_ACCOUNT_ID=

# Opcional: bankAccountId ya registrados en pey para las CLABEs, en JSON {"CLABE":"ULID"}.
# También puedes registrarlas desde la pantalla /cuentas.
PEY_BANK_ACCOUNTS={}
